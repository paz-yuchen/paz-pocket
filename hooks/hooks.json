{
  "description": "Distill durable knowledge after each Codex session ends.",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.codex/hooks/session_end_distill.py",
            "timeout": 3,
            "statusMessage": "Starting session distillation"
          }
        ]
      }
    ]
  }
}
